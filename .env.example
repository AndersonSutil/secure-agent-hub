# Copie para overlay/.env (repositório privado) e ajuste. Nada aqui é segredo.

# Onde ficam os dados persistentes (Qdrant, modelos, logs). Use um disco com espaço.
HUB_DATA_DIR=/srv/agentes-hub/data

# Pasta do overlay privado (padrão: ./overlay dentro do repositório).
HUB_OVERLAY_DIR=./overlay

# GPU para embeddings: índice/UUID do CDI (ex.: 0, 1) ou "cpu".
EMBED_GPU=cpu

# Modelo de embedding no Ollama dedicado.
HUB_EMBED_MODEL=qwen3-embedding:0.6b

# Porta local do MCP (publicada só em 127.0.0.1).
HUB_MCP_PORT=8765

# 1 = imagem com classificador de injeção (torch CPU, ~1 GB). 0 = sem classificador
# (conteúdo untrusted e memória vão para quarentena se on_unavailable=quarantine).
HUB_WITH_GUARD=1

# Chave age (privada) e destino dos backups criptografados.
SOPS_AGE_KEY_FILE=~/.config/sops/age/keys.txt
BACKUP_DIR=/srv/agentes-hub/backups
