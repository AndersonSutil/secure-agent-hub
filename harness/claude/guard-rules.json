    },
    {
      "id": "git-push",
      "why": "Publicação só pelo broker, com aprovação humana.",
      "regex": "(^|[\\s;&|(])git\\s+(-C\\s+\\S+\\s+)?push\\b"
    },
    {
      "id": "git-hooks",
      "why": "Hooks git executam código em quem fizer checkout.",
      "regex": "\\.git/hooks"
    },
    {
      "id": "credential-files",
      "why": "Leitura de credenciais de provedores/segredos.",
